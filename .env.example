# Run pnpm auth:setup in an interactive terminal to create .env.local and a private QR.
# No credentials are embedded in the app or Docker image.
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=
SESSION_SECRET=
# Exact external origin: no trailing slash, credentials, path, query or fragment.
APP_ORIGIN=http://127.0.0.1:3000
# Optional host installation override; compose sets this to /app/data.
# DATA_DIR=/var/lib/strategy-monitor
# Optional compose HTTPS profile: set MONITOR_HOST in .env (domain only).
