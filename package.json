{
  "name": "strategy-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm test && next build && tsx tools/package-standalone.ts",
    "start": "next start --hostname 127.0.0.1",
    "seed": "tsx tools/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fixtures:export": "sh tools/export-fixtures.sh",
    "run:now": "tsx tools/run.ts",
    "auth:setup": "tsx tools/auth-setup.ts",
    "smoke": "tsx tools/smoke-production.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "node-cron": "^4.2.0",
    "otplib": "^13.6.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
